# Copy this file to .env and fill local secrets.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ENABLE_AZURE_TTS=false
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
PORT=5033
HOST=127.0.0.1

# Robot connectivity and teaching simulation are independent choices.
AUTO_CONNECT_RTDE=1
UR10E_IP=192.168.1.10
MASSAGE_SIMULATION_MODE=0

# Azure streaming ASR: silence before finalizing a phrase (100–5000 ms).
STT_SEGMENTATION_SILENCE_MS=300
